generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum EndReason {
  TIMER
  BUY_NOW
}

model Auction {
  id           String        @id @default(uuid())
  title        String
  description  String?
  photoUrl     String
  sellerId     String
  sellerName   String
  currency     String        @default("USD")
  startPrice   Int
  minIncrement Int
  buyNowPrice  Int?
  currentPrice Int
  leaderId     String?
  leaderName   String?
  status       AuctionStatus @default(SCHEDULED)
  startsAt     DateTime?
  endsAt       DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bids         Bid[]
  winner       Winner?

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  userId    String
  userName  String
  amount    Int
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt(sort: Desc)])
  @@map("bids")
}

model Winner {
  id         String    @id @default(uuid())
  auctionId  String    @unique
  userId     String
  userName   String
  finalPrice Int
  reason     EndReason
  createdAt  DateTime  @default(now())
  auction    Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@map("winners")
}
